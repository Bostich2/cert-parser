HOST=0.0.0.0
PORT=8000
BELGISS_API_URL=https://api.belgiss.by
BELGISS_PUBLIC_URL=https://tsouz.belgiss.by
REQUEST_TIMEOUT_SECONDS=30
LOOKUP_CONCURRENCY=2
LOOKUP_DELAY_SECONDS=0.25
CACHE_TTL_SECONDS=86400
CACHE_PATH=data/cache.sqlite
MAX_BATCH_SIZE=100
BELGISS_SSL_VERIFY=true
HTTP_SSL_VERIFY=true
FSA_BASE_URL=https://pub.fsa.gov.ru
EOKNO_REGISTER_URL=https://eokno.gov.kz/public-register/register-ktrm.xhtml
SWIS_BASE_URL=https://swis.trade.kg
EAEU_ODATA_URL=https://tech.eaeunion.org/odata/ConformityDocDetailsType
EAEU_REGISTER_VIEW_URL=https://tech.eaeunion.org/tech/registers/35-1/ru/registryList/conformityDocs/view
XLSX_MAX_BYTES=15728640
PDF_MAX_BYTES=15728640
PDF_OCR_MAX_PAGES=5
PDF_OCR_ENABLED=true
PDF_OCR_REC_LANG=eslav
LOG_LEVEL=INFO
# CERT_PARSER_VERSION=0.2.0

# --- Auth (optional; required for production deploy) ---
# AUTH_ENABLED=false
# AUTH_SECRET_KEY=
# AUTH_USERS=[{"username":"admin","password_hash":"...","role":"admin"}]
# AUTH_SECURE_COOKIES=false
# AUTH_SESSION_MAX_AGE=86400
# ALLOWED_HOSTS=*
# ENV=development
# RATE_LIMIT_LOGIN=5/minute
# RATE_LIMIT_UPLOAD=10/minute
# RATE_LIMIT_LOOKUP=30/minute
