# Copy to project root as .env.prod and fill in values before:
#   docker compose -f docker-compose.prod.yml up -d --build

ENV=production
HOST=0.0.0.0
PORT=8000

# Comma-separated hostnames served by Caddy (must match deploy/Caddyfile).
ALLOWED_HOSTS=example.com

# Generate: python -c "import secrets; print(secrets.token_hex(32))"
AUTH_SECRET_KEY=

# Generate users:
#   python scripts/hash_password.py 'your-password' --username admin --role admin
#   python scripts/hash_password.py 'your-password' --username user --role user
AUTH_USERS=[{"username":"admin","password_hash":"REPLACE_ME","role":"admin"}]
AUTH_ENABLED=true
AUTH_SECURE_COOKIES=true
AUTH_SESSION_MAX_AGE=86400

APP_VERSION=0.2.0
CACHE_PATH=/app/data/cache.sqlite
CACHE_TTL_SECONDS=86400
MAX_BATCH_SIZE=100
LOOKUP_CONCURRENCY=2
LOOKUP_DELAY_SECONDS=0.25
HTTP_SSL_VERIFY=true

PDF_MAX_BYTES=15728640
XLSX_MAX_BYTES=15728640
PDF_OCR_MAX_PAGES=5
PDF_OCR_ENABLED=true
PDF_OCR_REC_LANG=eslav
LOG_LEVEL=INFO

# Optional: proxy for FSA (Russia) from non-RU IP
# HTTPS_PROXY=http://user:pass@proxy.example:8080

# Registry URLs (defaults usually fine)
BELGISS_API_URL=https://api.belgiss.by
BELGISS_PUBLIC_URL=https://tsouz.belgiss.by
FSA_BASE_URL=https://pub.fsa.gov.ru
EOKNO_REGISTER_URL=https://eokno.gov.kz/public-register/register-ktrm.xhtml
SWIS_BASE_URL=https://swis.trade.kg
EAEU_ODATA_URL=https://tech.eaeunion.org/odata/ConformityDocDetailsType
EAEU_REGISTER_VIEW_URL=https://tech.eaeunion.org/tech/registers/35-1/ru/registryList/conformityDocs/view

RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_UPLOAD=10/minute
RATE_LIMIT_LOOKUP=30/minute
